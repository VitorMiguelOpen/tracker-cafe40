# Broker MQTT
MQTT_HOST=opensolutionsbr.ddns.net
MQTT_PORT=1883
MQTT_CLIENT_ID=cafe-tracker-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=/IoT/SAACE/DADOSAPONTAMENTO

# Banco de dados
# Deixe vazio para usar o padrão do appsettings.json (Postgres local do docker-compose).
# Para sobrescrever, use algo como:
# DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=cafetracker;Username=postgres;Password=postgres
DB_CONNECTION_STRING=

# API
ASPNETCORE_URLS=http://localhost:5000
