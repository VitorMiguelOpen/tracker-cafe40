# Broker MQTT
MQTT_HOST=opensolutionsbr.ddns.net
MQTT_PORT=1883
MQTT_CLIENT_ID=cafe-tracker-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=/IoT/SAACE/DADOSAPONTAMENTO

# Banco de dados (DEV)
# Em desenvolvimento (F5 / dotnet run) o backend usa SQLite e ignora isto.
# Deixe vazio. (Preencher com um Postgres aqui faria o app dev falhar.)
DB_CONNECTION_STRING=

# API (DEV)
ASPNETCORE_URLS=http://localhost:5000

# ===== Docker / servidor (Caminho A) — docker compose up =====
# Senha do PostgreSQL central. Em produção, troque por uma senha forte.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cafetracker

# Porta do host onde o dashboard fica acessível (http://localhost:APP_PORT).
# No servidor pode deixar 5000. Na sua máquina, use 5001 para o backup Docker
# rodar SEM conflitar com o backend de desenvolvimento (que usa a 5000).
APP_PORT=5000
