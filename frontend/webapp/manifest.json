{
  "_version": "1.40.0",
  "sap.app": {
    "id": "cafetracker",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{i18n>appTitle}",
    "description": "{i18n>appDescription}",
    "applicationVersion": {
      "version": "1.0.0"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "cafetracker.view.Dashboard",
      "type": "XML",
      "id": "dashboard",
      "async": true
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.ui.layout": {},
        "sap.f": {},
        "sap.viz": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "cafetracker.i18n.i18n"
        }
      }
    },
    "resources": {
      "css": [
        { "uri": "css/style.css" }
      ]
    }
  }
}
